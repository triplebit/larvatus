{
  "manifest_version": 3,
  "name": "Alias Ledger",
  "version": "1.0.0",
  "description": "Create, find and switch Stalwart masked addresses on or off.",
  "browser_specific_settings": {
    "gecko": {
      "id": "alias-ledger@extensions.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "personallyIdentifyingInfo"]
      }
    }
  },
  "action": { "default_title": "Alias Ledger", "default_popup": "popup.html", "default_icon": "icon.svg" },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "background": { "scripts": ["background.js"], "type": "module" },
  "options_ui": { "page": "account.html", "open_in_tab": true },
  "permissions": ["identity", "storage"],
  "optional_host_permissions": ["https://*/*"]
}
