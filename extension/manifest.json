{
  "manifest_version": 3,
  "name": "Larvatus",
  "version": "1.0.1",
  "description": "Create, find and switch Stalwart masked addresses on or off.",
  "homepage_url": "https://larvat.us/",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@larvatus.net",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "personallyIdentifyingInfo"],
        "optional": ["browsingActivity"]
      }
    }
  },
  "action": { "default_title": "Larvatus", "default_popup": "popup.html", "default_icon": "icon.svg" },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "background": { "scripts": ["background.js"], "type": "module" },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "permissions": ["activeTab", "identity", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"]
}
